rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /rooms/{room}/msgs/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      // Owner can edit; anyone can add/remove reactions (the "rx" field only)
      allow update: if request.auth != null && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx']));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
